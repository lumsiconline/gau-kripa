# Local development placeholders only. Never commit real credentials.
# Razorpay LIVE credentials are read by the Express backend (server.ts) only.
RAZORPAY_KEY_ID="YOUR_LIVE_RAZORPAY_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_LIVE_RAZORPAY_KEY_SECRET"

# Public Razorpay Key ID (optional fallback for frontend checkout)
VITE_RAZORPAY_KEY_ID="YOUR_LIVE_RAZORPAY_KEY_ID"

# Full origin of your deployed Express backend (required when frontend is hosted statically e.g. GitHub Pages)
# Example: VITE_API_BASE_URL="https://api.gaukripa.site"
VITE_API_BASE_URL=""

# Firebase Functions base URL for Razorpay wallet endpoints (getWallet, createRazorpayOrder, verifyRazorpayPayment)
VITE_FIREBASE_FUNCTIONS_URL="https://asia-south1-gau-kripa.cloudfunctions.net"

# Comma-separated frontend origins allowed for CORS on the Express backend
ALLOWED_ORIGIN="https://gaukripa.site,https://www.gaukripa.site"
