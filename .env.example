# Local development placeholders only. Never commit real credentials.

# Supabase Project Credentials (Frontend - Public Anon Key)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Supabase Server Credentials (Used by local Express server.ts only - NEVER expose in client bundle)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Razorpay LIVE Credentials (Stored in Supabase Edge Function Secrets & Express backend only)
RAZORPAY_KEY_ID="YOUR_LIVE_RAZORPAY_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_LIVE_RAZORPAY_KEY_SECRET"

# Public Razorpay Key ID (optional fallback for frontend checkout)
VITE_RAZORPAY_KEY_ID="YOUR_LIVE_RAZORPAY_KEY_ID"

# Optional Express Backend Origin (used only when running without Supabase)
VITE_API_BASE_URL=""

# Comma-separated frontend origins allowed for CORS on the Express backend
ALLOWED_ORIGIN="https://gaukripa.site,https://www.gaukripa.site"
